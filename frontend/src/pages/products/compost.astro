---
/**
 * Compost Category Page
 *
 * Georgia's ONLY organic compost
 * Route: /products/compost
 */

import MainLayout from '../../layouts/MainLayout.astro';
import ProductCard from '../../components/products/ProductCard.astro';
import MaterialCalculator from '../../components/products/MaterialCalculator.astro';
import AddToCartButton from '../../components/cart/AddToCartButton.astro';
import PdProductView from '../../components/PdProductView.astro';
import { getProductsByCategory, getProductBySlug } from '../../lib/products';
import { business } from '../../lib/business';
import { farmId } from '../../lib/schema';
import { imagePresets } from '../../lib/cloudinary';

const products = getProductsByCategory('compost');
const humus = getProductBySlug('humus-compost');

const faqs = [
  {
    q: 'Where can I buy compost near me?',
    a: `Buy compost at Soul Miner's Eden, 189 Luke Road in Bogart — about twenty minutes from Athens. Pickup is Monday–Saturday, 8am–6pm. Call ${business.phone} if you want us to load you.`,
  },
  {
    q: 'Do you sell compost in bulk?',
    a: 'Yes. We sell bulk compost by the cubic yard — $45 a yard. A pickup truck holds a yard (16 to 18 cubic feet). No bagged retail. No minimum for pickup.',
  },
  {
    q: 'Do you deliver compost near Athens?',
    a: 'We deliver bulk compost around Athens and the nearby counties. Delivery is $40 plus $1.25 a mile after 20 miles, three-yard minimum. Same-week on most orders.',
  },
  {
    q: 'What is a cubic yard of compost?',
    a: 'A cubic yard is 27 cubic feet — about what fits in a full-size pickup. It weighs roughly 1,000 to 1,400 pounds. That is the unit we sell.',
  },
  {
    q: 'Can I pick up compost today?',
    a: 'If we are open, yes. Compost is in stock at the farm. Come to 189 Luke Road, Bogart, Monday–Saturday 8am–6pm, or call ahead so we can have a yard ready.',
  },
];

// MUX video for compost hero
const muxPlaybackId = 'eql45dBwcc3we00ywhZRoo2Vu2EETkDALwWUjRmEt6ZU';
const muxPosterUrl = `https://image.mux.com/${muxPlaybackId}/thumbnail.jpg?time=0`;
const muxStreamUrl = `https://stream.mux.com/${muxPlaybackId}.m3u8`;
---

<MainLayout
  title="Organic Compost Athens GA | $45 a Yard | Soul Miner's Eden"
  description="Buy organic compost in Athens, GA — $45 a cubic yard. In stock at 189 Luke Road, Bogart. Pickup Mon–Sat 8am–6pm. Call (706) 613-4415."
  ogType="product"
>
  {humus && (
    <PdProductView productId={humus.slug} productName={humus.name} productPrice={humus.price} />
  )}

  <!-- Hero Section with Video Background -->
  <section class="compost-hero relative py-20 md:py-28 overflow-hidden">
    <!-- Background Video -->
    <div class="compost-video-wrapper">
      <video
        id="compost-hero-video"
        class="compost-video"
        autoplay
        muted
        loop
        playsinline
        poster={muxPosterUrl}
        data-stream-url={muxStreamUrl}
      >
      </video>
      <!-- 50% Black Overlay -->
      <div class="compost-video-overlay"></div>
    </div>

    <!-- Hero Content — this URL is the product Google already sends people to -->
    <div class="container-custom relative z-10">
      <div class="max-w-3xl mx-auto text-center text-white">
        <p class="text-sm font-semibold uppercase tracking-wider text-white/80 mb-3">In stock · Pickup today</p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold mb-4 leading-tight">
          Organic Compost in Athens
        </h1>
        <p class="text-2xl md:text-3xl font-semibold mb-4">$45 a cubic yard</p>
        <p class="text-lg md:text-xl mb-8 leading-relaxed text-white/90">
          Buy bulk compost near Athens. Pickup on Luke Road in Bogart, or we deliver. No biosolids. A yard is 16 to 18 cubic feet.
        </p>
        {humus && (
          <div class="max-w-md mx-auto mb-4">
            <AddToCartButton productSlug={humus.slug} productName={humus.name} />
          </div>
        )}
        <a href={business.phoneHref} class="inline-block text-white font-semibold underline underline-offset-4">
          Or call {business.phone}
        </a>
        <p class="mt-4 text-sm text-white/75">
          {business.address.full} · {business.hours.display}
        </p>
      </div>
    </div>
  </section>

  <div class="container-custom py-16">
    <!-- Introduction -->
    <section class="mb-16">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-warm-900 mb-6">
          Why Soul Miner's Eden Compost?
        </h2>
        <p class="text-xl text-warm-700 leading-relaxed mb-8">
          Buy compost from the farm that makes it — twenty minutes from Athens, on Luke Road in Bogart. Load a bulk yard on your truck, or we deliver. No biosolids. $45 a cubic yard.
        </p>
      </div>

      <!-- Key Benefits Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
        <div class="feature-box">
          <div class="text-4xl mb-4">🌱</div>
          <h3 class="font-bold text-xl mb-3 text-warm-900">100% All-Natural</h3>
          <p class="text-warm-700">
            We are committed to All-Natural and Organic standards. Our production is ideal for vegetables, fruits, and organic farms.
          </p>
        </div>

        <div class="feature-box">
          <div class="text-4xl mb-4">🦠</div>
          <h3 class="font-bold text-xl mb-3 text-warm-900">Living Soil</h3>
          <p class="text-warm-700">
            Packed with beneficial microorganisms that improve soil health, suppress diseases, and promote vigorous plant growth.
          </p>
        </div>

        <div class="feature-box">
          <div class="text-4xl mb-4">💧</div>
          <h3 class="font-bold text-xl mb-3 text-warm-900">Water Smart</h3>
          <p class="text-warm-700">
            Improves soil structure and water retention, reducing irrigation needs while preventing nutrient runoff.
          </p>
        </div>
      </div>
    </section>

    <!-- Products -->
    <section class="mb-16">
      <h2 class="text-3xl font-display font-bold text-warm-900 mb-8 text-center">
        Our Compost Products
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-5xl mx-auto">
        {products.map(product => (
          <ProductCard product={product} variant="featured" />
        ))}
      </div>
    </section>

    <!-- Material Calculator -->
    <section class="mb-16">
      <MaterialCalculator />
    </section>

    <!-- Applications & Use Cases -->
    <section class="mb-16">
      <h2 class="text-3xl font-display font-bold text-warm-900 mb-8 text-center">
        Perfect For
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        <div class="bg-primary-50 rounded-xl p-6 border border-primary-200">
          <h3 class="font-bold text-xl mb-3 text-warm-900">🥕 Vegetable Gardens</h3>
          <p class="text-warm-700 mb-4">
            100% organic for edible crops. Adds nutrients naturally without synthetic chemicals.
          </p>
          <p class="text-sm text-primary-700 font-semibold">
            Recommended depth: 3-4 inches mixed into soil
          </p>
        </div>

        <div class="bg-primary-50 rounded-xl p-6 border border-primary-200">
          <h3 class="font-bold text-xl mb-3 text-warm-900">🌸 Flower Beds</h3>
          <p class="text-warm-700 mb-4">
            Improves soil structure and provides slow-release nutrition for vibrant blooms.
          </p>
          <p class="text-sm text-primary-700 font-semibold">
            Recommended depth: 2-3 inches as top dressing
          </p>
        </div>

        <div class="bg-primary-50 rounded-xl p-6 border border-primary-200">
          <h3 class="font-bold text-xl mb-3 text-warm-900">🌿 Lawn Care</h3>
          <p class="text-warm-700 mb-4">
            Top-dress lawns to improve soil health and reduce need for synthetic fertilizers.
          </p>
          <p class="text-sm text-primary-700 font-semibold">
            Recommended: 1/4-1/2 inch spread evenly
          </p>
        </div>

        <div class="bg-primary-50 rounded-xl p-6 border border-primary-200">
          <h3 class="font-bold text-xl mb-3 text-warm-900">🌳 Trees & Shrubs</h3>
          <p class="text-warm-700 mb-4">
            Mix into planting holes for healthier root development and long-term nutrition.
          </p>
          <p class="text-sm text-primary-700 font-semibold">
            Recommended: Mix 30% compost with native soil
          </p>
        </div>
      </div>
    </section>

    <!-- Why Organic Matters -->
    <section class="mb-16 bg-gradient-to-br from-accent-50 to-primary-50 rounded-2xl p-8 md:p-12 border border-primary-200">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-display font-bold text-warm-900 mb-6 text-center">
          Why Organic Compost Matters
        </h2>
        <div class="space-y-4 text-warm-700">
          <p class="text-lg">
            <strong class="text-accent-700">Zero Synthetic Chemicals:</strong> No pesticides, herbicides, or synthetic fertilizers. Safe for growing food and protecting pollinators.
          </p>
          <p class="text-lg">
            <strong class="text-accent-700">Natural Standards:</strong> Our compost meets strict organic standards year after year.
          </p>
          <p class="text-lg">
            <strong class="text-accent-700">Support Local Organic Farming:</strong> Your purchase supports sustainable agriculture and local organic practices in Georgia.
          </p>
          <p class="text-lg">
            <strong class="text-accent-700">Healthier Soil Ecosystem:</strong> Build living soil that sustains itself with beneficial microbes, not chemical inputs.
          </p>
        </div>
      </div>
    </section>

    <section class="mb-16 max-w-3xl mx-auto">
      <h2 class="text-3xl font-display font-bold text-warm-900 mb-8 text-center">
        Compost near Athens — common questions
      </h2>
      <dl class="space-y-6">
        {faqs.map((item) => (
          <div>
            <dt class="font-semibold text-lg text-warm-900 mb-2">{item.q}</dt>
            <dd class="text-warm-700 leading-relaxed">{item.a}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- CTA -->
    <section class="text-center">
      <div class="bg-gradient-to-br from-primary-600 to-primary-700 text-white rounded-2xl p-8 md:p-12 max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold mb-4">
          Ready for a yard?
        </h2>
        <p class="text-xl text-primary-100 mb-8">
          $45 a cubic yard. Pickup at the farm or we deliver around Athens.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center max-w-md mx-auto">
          {humus && (
            <div class="flex-1">
              <AddToCartButton productSlug={humus.slug} productName={humus.name} />
            </div>
          )}
          <a href={business.phoneHref} class="btn bg-white text-primary-600 hover:bg-primary-50 text-lg px-8 py-4 text-center">
            Call {business.phone}
          </a>
        </div>
        <p class="mt-6 text-sm text-primary-100">
          Delivery: $40 base + $1.25/mile after 20 miles | Pickup available in Bogart, GA
        </p>
      </div>
    </section>
  </div>

  {humus && (
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Product',
          name: humus.name,
          description: humus.description,
          image: imagePresets.blogFeatured(humus.images.primary),
          sku: humus.sku,
          brand: { '@type': 'Brand', name: business.name },
          offers: {
            '@type': 'Offer',
            url: `${business.url}/products/compost/`,
            price: humus.price,
            priceCurrency: 'USD',
            availability: humus.inStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
            itemCondition: 'https://schema.org/NewCondition',
            seller: { '@id': farmId },
          },
        },
        {
          '@type': 'FAQPage',
          mainEntity: faqs.map((item) => ({
            '@type': 'Question',
            name: item.q,
            acceptedAnswer: { '@type': 'Answer', text: item.a },
          })),
        },
      ],
    })} />
  )}
</MainLayout>

<style>
  /* Compost hero video background styles */
  .compost-hero {
    position: relative;
    isolation: isolate;
  }

  .compost-video-wrapper {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }

  .compost-video {
    position: absolute;
    top: 50%;
    left: 50%;
    min-width: 100%;
    min-height: 100%;
    width: auto;
    height: auto;
    transform: translate(-50%, -50%);
    object-fit: cover;
  }

  .compost-video-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.5);
  }
</style>

<script is:inline src="https://cdn.jsdelivr.net/npm/hls.js@1"></script>
<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var video = document.getElementById('compost-hero-video');
    if (!video) return;

    var streamUrl = video.dataset.streamUrl;
    if (!streamUrl) return;

    if (video.canPlayType('application/vnd.apple.mpegurl')) {
      video.src = streamUrl;
      video.play().catch(function() {});
    } else if (typeof Hls !== 'undefined' && Hls.isSupported()) {
      var hls = new Hls();
      hls.loadSource(streamUrl);
      hls.attachMedia(video);
      hls.on(Hls.Events.MANIFEST_PARSED, function() {
        video.play().catch(function() {});
      });
    }
  });
</script>
