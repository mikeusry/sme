---
export const prerender = false
/**
 * Admin Order Management Page
 *
 * View and manage farm orders with pickup scheduling.
 * Grouped by pickup date for easy fulfillment tracking.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Orders" description="Paid tickets from the site. Hold the load, then mark collected.">
  <div class="orders-toolbar">
    <button id="refresh-orders" class="admin-btn admin-btn-outline" type="button">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
      Refresh
    </button>
  </div>

  <div class="admin-stat-grid">
    <div class="admin-card admin-stat-card">
      <div>
        <p class="stat-label">Today</p>
        <p class="stat-value" id="stat-today">—</p>
      </div>
      <div class="stat-icon" aria-hidden="true">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
      </div>
    </div>
    <div class="admin-card admin-stat-card">
      <div>
        <p class="stat-label">Pickups</p>
        <p class="stat-value" id="stat-week">—</p>
      </div>
      <div class="stat-icon" aria-hidden="true">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
      </div>
    </div>
    <div class="admin-card admin-stat-card">
      <div>
        <p class="stat-label">Delivery</p>
        <p class="stat-value" id="stat-delivery">—</p>
      </div>
      <div class="stat-icon" aria-hidden="true">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 17a2 2 0 11-4 0 2 2 0 014 0zm10 0a2 2 0 11-4 0 2 2 0 014 0zM13 16V6H4v10h1m8-1H9m4-7h3l3 3v5h-1" /></svg>
      </div>
    </div>
    <div class="admin-card admin-stat-card">
      <div>
        <p class="stat-label">Revenue</p>
        <p class="stat-value" id="stat-revenue">$0</p>
      </div>
      <div class="stat-icon" aria-hidden="true">$</div>
    </div>
  </div>

  <div class="admin-card filter-bar">
    <button class="filter-btn active" data-filter="all" type="button">All</button>
    <button class="filter-btn" data-filter="today" type="button">Today</button>
    <button class="filter-btn" data-filter="pickup" type="button">Pickup</button>
    <button class="filter-btn" data-filter="delivery" type="button">Delivery</button>
    <button class="filter-btn" data-filter="ready" type="button">Ready</button>
    <button class="filter-btn" data-filter="collected" type="button">Collected</button>
  </div>

  <div id="orders-loading" class="orders-status">Loading orders…</div>

  <div id="orders-content" class="hidden">
    <div id="orders-list"></div>
  </div>

  <div id="orders-empty" class="hidden">
    <div class="admin-card orders-empty">
      <h2>No orders yet</h2>
      <p>Paid pickups from the site will show here.</p>
    </div>
  </div>
</AdminLayout>

<style is:global>
  .orders-toolbar {
    display: flex;
    justify-content: flex-end;
    margin: -1rem 0 1.25rem;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    margin-bottom: 1.25rem;
  }

  .filter-btn {
    padding: 0.375rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-muted);
    background: var(--surface-alt);
    border: 1px solid var(--border);
    cursor: pointer;
    font-family: inherit;
  }

  .filter-btn:hover { color: var(--text); }

  .filter-btn.active {
    background: var(--admin-primary);
    color: #fff;
    border-color: var(--admin-primary);
  }

  .orders-status, .orders-empty {
    text-align: center;
    padding: 2.5rem 1.25rem;
    color: var(--text-muted);
  }

  .orders-empty h2 {
    font-family: var(--headingFont);
    font-size: 1.25rem;
    color: var(--text);
    margin-bottom: 0.35rem;
  }

  .order-group { margin-bottom: 1.5rem; }

  .order-group h2 {
    font-family: var(--headingFont);
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .order-group h2 span {
    font-family: var(--bodyFont);
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--text-muted);
    margin-left: 0.35rem;
  }

  .order-card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.15rem 1.25rem;
    background: var(--surface);
    margin-bottom: 0.75rem;
  }

  .order-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }

  .order-head h3 {
    font-size: 1rem;
    font-weight: 600;
  }

  .order-head p { font-size: 0.875rem; color: var(--text-muted); }

  .order-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(6.5rem, 8rem));
    gap: 0.75rem 1.5rem;
    margin-bottom: 0.85rem;
  }

  @media (max-width: 700px) {
    .order-meta { grid-template-columns: repeat(2, 1fr); }
  }

  .order-meta p:first-child {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  .order-meta p:last-child { font-weight: 600; }

  .order-contact {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 0.85rem;
  }

  .order-note {
    background: var(--warning-light);
    color: #92400e;
    border-radius: var(--radius);
    padding: 0.65rem 0.75rem;
    font-size: 0.875rem;
    margin-bottom: 0.85rem;
  }

  .order-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }

  .status-badge {
    display: inline-flex;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .status-badge.awaiting-pickup, .status-badge.awaiting { background: var(--warning-light); color: #92400e; }
  .status-badge.ready { background: var(--success-light); color: #166534; }
  .status-badge.collected { background: #e0e7ff; color: #3730a3; }
  .status-badge.awaiting-delivery, .status-badge.delivery { background: #fce7f3; color: #831843; }
</style>

<script>
  // Mock order data - In production, this would fetch from Medusa or your backend
  interface Order {
    id: string;
    orderNumber: string;
    customerName: string;
    email: string;
    phone?: string;
    total: number;
    itemCount: number;
    status: 'awaiting_pickup' | 'ready' | 'collected' | 'awaiting_delivery';
    fulfillmentMethod: 'pickup' | 'delivery';
    pickupDate?: string;
    pickupTime?: string;
    notes?: string;
    createdAt: string;
  }

  let orders: Order[] = [];
  let activeFilter = 'all';
  let isLoading = true;

  /**
   * Fetch orders from API
   */
  async function fetchOrders() {
    try {
      isLoading = true;
      document.getElementById('orders-loading')?.classList.remove('hidden');
      document.getElementById('orders-content')?.classList.add('hidden');
      document.getElementById('orders-empty')?.classList.add('hidden');

      const response = await fetch('/api/admin/orders');
      const data = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(data.error || 'Failed to fetch orders');
      }

      orders = data.orders || [];

      updateStats();
      renderOrders();
    } catch (error: any) {
      console.error('Error fetching orders:', error);
      // Show empty state with error message
      document.getElementById('orders-empty')?.classList.remove('hidden');
      const emptyTitle = document.querySelector('#orders-empty h2');
      if (emptyTitle) emptyTitle.textContent = 'Failed to Load Orders';
      const emptyDesc = document.querySelector('#orders-empty p');
      if (emptyDesc) emptyDesc.textContent = error.message || 'Please try refreshing the page.';
    } finally {
      isLoading = false;
      document.getElementById('orders-loading')?.classList.add('hidden');
    }
  }

  function formatPrice(cents: number): string {
    return new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: 'USD',
    }).format(cents / 100);
  }

  function localDayKey(dateStr: string): string {
    if (/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) return dateStr;
    const d = new Date(dateStr);
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
  }

  function formatDate(dateStr: string): string {
    const [y, m, d] = localDayKey(dateStr).split('-').map(Number);
    const date = new Date(y, m - 1, d);
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const orderDate = new Date(date);
    orderDate.setHours(0, 0, 0, 0);

    if (orderDate.getTime() === today.getTime()) {
      return 'Today';
    }

    const tomorrow = new Date(today);
    tomorrow.setDate(today.getDate() + 1);

    if (orderDate.getTime() === tomorrow.getTime()) {
      return 'Tomorrow';
    }

    return date.toLocaleDateString('en-US', {
      weekday: 'short',
      month: 'short',
      day: 'numeric',
    });
  }

  function getTimeSlotLabel(slot: string): string {
    const slots: Record<string, string> = {
      morning: '8 AM - 12 PM',
      afternoon: '12 PM - 5 PM',
      evening: '5 PM - 7 PM',
      anytime: '24/7 Access',
    };
    return slots[slot] || slot;
  }

  function updateStats() {
    const today = localDayKey(new Date().toISOString());

    const todayPickups = orders.filter(o =>
      localDayKey(o.pickupDate || o.createdAt) === today && o.fulfillmentMethod === 'pickup'
    ).length;
    const weekPickups = orders.filter(o => o.fulfillmentMethod === 'pickup' && o.status !== 'collected').length;
    const pendingDelivery = orders.filter(o => o.fulfillmentMethod === 'delivery' && o.status !== 'collected').length;
    const revenue = orders.reduce((sum, o) => sum + o.total, 0);

    document.getElementById('stat-today')!.textContent = todayPickups.toString();
    document.getElementById('stat-week')!.textContent = weekPickups.toString();
    document.getElementById('stat-delivery')!.textContent = pendingDelivery.toString();
    document.getElementById('stat-revenue')!.textContent = formatPrice(revenue);
  }

  function filterOrders(filter: string): Order[] {
    const today = localDayKey(new Date().toISOString());

    switch (filter) {
      case 'today':
        return orders.filter(o => localDayKey(o.pickupDate || o.createdAt) === today);
      case 'pickup':
        return orders.filter(o => o.fulfillmentMethod === 'pickup');
      case 'delivery':
        return orders.filter(o => o.fulfillmentMethod === 'delivery');
      case 'ready':
        return orders.filter(o => o.status === 'ready');
      case 'collected':
        return orders.filter(o => o.status === 'collected');
      default:
        return orders;
    }
  }

  function groupOrdersByDate(orders: Order[]): Map<string, Order[]> {
    const grouped = new Map<string, Order[]>();

    orders.forEach(order => {
      const key = order.fulfillmentMethod === 'delivery'
        ? 'delivery'
        : localDayKey(order.pickupDate || order.createdAt);
      if (!grouped.has(key)) {
        grouped.set(key, []);
      }
      grouped.get(key)!.push(order);
    });

    return grouped;
  }

  function renderOrders() {
    const filteredOrders = filterOrders(activeFilter);
    const grouped = groupOrdersByDate(filteredOrders);

    const ordersListEl = document.getElementById('orders-list');
    if (!ordersListEl) return;

    if (grouped.size === 0) {
      document.getElementById('orders-content')?.classList.add('hidden');
      document.getElementById('orders-empty')?.classList.remove('hidden');
      return;
    }

    document.getElementById('orders-content')?.classList.remove('hidden');
    document.getElementById('orders-empty')?.classList.add('hidden');

    // Sort dates
    const sortedDates = Array.from(grouped.keys()).sort((a, b) => {
      if (a === 'delivery') return 1;
      if (b === 'delivery') return -1;
      return new Date(a).getTime() - new Date(b).getTime();
    });

    ordersListEl.innerHTML = sortedDates.map(date => {
      const dateOrders = grouped.get(date)!;
      const isDelivery = date === 'delivery';

      return `
        <div class="order-group">
          <h2>
            ${isDelivery ? 'Pending Delivery' : formatDate(date)}
            <span>(${dateOrders.length} ${dateOrders.length === 1 ? 'order' : 'orders'})</span>
          </h2>
          ${dateOrders.map(order => `
              <div class="order-card">
                <div class="order-head">
                  <div>
                    <h3>${order.orderNumber}</h3>
                    <p>${order.customerName}</p>
                  </div>
                  <span class="status-badge ${order.status.replace(/_/g, '-')}">${order.status.replace(/_/g, ' ')}</span>
                </div>
                <div class="order-meta">
                  <div><p>Items</p><p>${order.itemCount}</p></div>
                  <div><p>Total</p><p>${formatPrice(order.total)}</p></div>
                  <div><p>Method</p><p>${order.fulfillmentMethod === 'pickup' ? 'Pickup' : 'Delivery'}</p></div>
                  ${order.pickupTime ? `<div><p>Window</p><p>${getTimeSlotLabel(order.pickupTime)}</p></div>` : ''}
                </div>
                ${order.email || order.phone ? `<p class="order-contact">${[order.email, order.phone].filter(Boolean).join(' · ')}</p>` : ''}
                ${order.notes ? `<div class="order-note"><strong>Note:</strong> ${order.notes}</div>` : ''}
                <div class="order-actions">
                  ${order.status === 'awaiting_pickup' ? `<button class="admin-btn admin-btn-primary" type="button" onclick="markReady('${order.id}')">Mark ready</button>` : ''}
                  ${order.status === 'ready' ? `<button class="admin-btn admin-btn-primary" type="button" onclick="markCollected('${order.id}')">Mark collected</button>` : ''}
                  ${order.phone ? `<a class="admin-btn admin-btn-outline" href="tel:${order.phone}">Call</a>` : ''}
                </div>
              </div>
            `).join('')}
        </div>
      `;
    }).join('');
  }

  // Event listeners
  document.getElementById('refresh-orders')?.addEventListener('click', () => {
    fetchOrders();
  });

  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      (e.target as HTMLElement).classList.add('active');
      activeFilter = (e.target as HTMLElement).dataset.filter || 'all';
      renderOrders();
    });
  });

  // Actions (call API endpoints)
  (window as any).markReady = async (orderId: string) => {
    const order = orders.find(o => o.id === orderId);
    if (!order) return;

    if (!confirm(`Mark order ${order.orderNumber} as ready for pickup?`)) return;

    try {
      const response = await fetch(`/api/admin/orders/${orderId}/mark-ready`, {
        method: 'POST',
      });

      if (!response.ok) {
        throw new Error('Failed to mark order ready');
      }

      // Update local state
      order.status = 'ready';
      renderOrders();
      updateStats();

      alert(`✓ Order ${order.orderNumber} is ready for pickup!\n\nCustomer notification sent.`);
    } catch (error: any) {
      console.error('Error marking order ready:', error);
      alert(`Failed to mark order ready: ${error.message}`);
    }
  };

  (window as any).markCollected = async (orderId: string) => {
    const order = orders.find(o => o.id === orderId);
    if (!order) return;

    if (!confirm(`Mark order ${order.orderNumber} as collected?`)) return;

    try {
      const response = await fetch(`/api/admin/orders/${orderId}/mark-collected`, {
        method: 'POST',
      });

      if (!response.ok) {
        throw new Error('Failed to mark order collected');
      }

      // Update local state
      order.status = 'collected';
      renderOrders();
      updateStats();

      alert(`✓ Order ${order.orderNumber} marked as collected!`);
    } catch (error: any) {
      console.error('Error marking order collected:', error);
      alert(`Failed to mark order collected: ${error.message}`);
    }
  };

  (window as any).viewOrder = (orderId: string) => {
    const order = orders.find(o => o.id === orderId);
    if (order) {
      alert(`View Order ${order.orderNumber}\n\nThis would open a detailed order view page.\n\n(Coming soon)`);
    }
  };

  // Initialize - Fetch orders on page load
  document.addEventListener('DOMContentLoaded', () => {
    fetchOrders();
  });
</script>
