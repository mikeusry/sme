---
import MainLayout from '../layouts/MainLayout.astro';
import ProductCard from '../components/products/ProductCard.astro';
import CloudinaryImage from '../components/CloudinaryImage.astro';
import ExperienceFarm from '../components/ExperienceFarm.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import FarmFresh from '../components/FarmFresh.astro';
import OriginStory from '../components/OriginStory.astro';
import EventsTeaser from '../components/EventsTeaser.astro';
import AddToCartButton from '../components/cart/AddToCartButton.astro';
import { getProductBySlug } from '../lib/products';
import { business } from '../lib/business';

const humusCompost = getProductBySlug('humus-compost');
const brownMulch = getProductBySlug('brown-mulch');
const topsoil = getProductBySlug('topsoil');

const muxPlaybackId = 'at00mmiQBibWz00AYKl2KvgHltoP7hzkRX02NtjzpMLX7w';
const muxPosterUrl = `https://image.mux.com/${muxPlaybackId}/thumbnail.jpg?time=0`;
const muxStreamUrl = `https://stream.mux.com/${muxPlaybackId}.m3u8`;
---

<MainLayout
	title="Soul Miner's Eden | A regenerative farm in Bogart, Georgia"
	description="Organic compost, $45 a yard. Pickup at 189 Luke Road, Bogart. A regenerative farm twenty minutes from Athens."
>
	<section class="hero-section relative overflow-hidden min-h-[88vh] flex items-end md:items-center">
		<div class="hero-video-wrapper">
			<video
				id="hero-video"
				class="hero-video"
				autoplay
				muted
				loop
				playsinline
				poster={muxPosterUrl}
				data-stream-url={muxStreamUrl}
			>
			</video>
		</div>
		<div class="hero-overlay"></div>

		<div class="container-custom relative z-10 pb-16 md:pb-0 pt-28">
			<div class="max-w-3xl">
				<p class="text-[11px] uppercase tracking-[0.28em] text-white/80 mb-5">
					Est. 2017 · Bogart, Georgia
				</p>
				<h1 class="font-display font-medium italic text-5xl md:text-7xl lg:text-[5.5rem] text-white leading-[1.05] mb-6">
					A regenerative farm.
				</h1>
				<p class="text-lg md:text-xl text-white/90 max-w-xl leading-relaxed mb-10">
					Compost is $45 a yard. Pickup on Luke Road. The rest is pasture, animals, and the work of making this land more beautiful.
				</p>
				<div class="flex flex-col sm:flex-row gap-3 sm:gap-5 items-stretch sm:items-center">
					<a href="/products/compost/" class="btn-primary text-center text-base md:text-lg px-8 py-4">
						Buy Compost — $45 / yard
					</a>
					<a href={business.phoneHref} class="text-white text-center sm:text-left underline underline-offset-4 decoration-white/40 hover:decoration-white py-3">
						Call {business.phone}
					</a>
				</div>
				<p class="mt-6 text-sm text-white/70">
					{business.address.full} · {business.hours.display}
				</p>
			</div>
		</div>
	</section>

	<section class="section bg-warm-50">
		<div class="container-custom">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
				<div class="overflow-hidden">
					<CloudinaryImage
						publicId="Soul Miner's/bin_3"
						alt="The farm stand at Soul Miner's Eden"
						width={900}
						height={720}
						crop="fill"
						gravity="auto"
						loading="eager"
						class="w-full h-[420px] md:h-[520px] object-cover"
					/>
				</div>
				<div>
					<p class="text-[11px] uppercase tracking-[0.22em] text-primary-600 mb-4">Welcome</p>
					<h2 class="font-display font-medium text-4xl md:text-5xl text-warm-900 leading-tight mb-6">
						Sixty-five acres, twenty minutes from Athens.
					</h2>
					<p class="text-lg text-warm-700 leading-relaxed mb-6">
						We steward this land so the soil gets better every year. Come walk the arbor, see the cows at the fence, and load a yard of compost that was made here.
					</p>
					<a href="/contact" class="text-primary-600 tracking-wide uppercase text-xs font-medium hover:text-primary-700">
						Plan a visit →
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="section bg-white">
		<div class="container-custom">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
				<div class="order-2 lg:order-1">
					<p class="text-[11px] uppercase tracking-[0.22em] text-primary-600 mb-4">From the farm</p>
					<h2 class="font-display font-medium text-4xl md:text-5xl text-warm-900 leading-tight mb-4">
						Humus compost
					</h2>
					<p class="text-3xl font-display text-warm-900 mb-5">$45 a cubic yard</p>
					<p class="text-lg text-warm-700 leading-relaxed mb-8">
						No biosolids. No fillers. Made on this farm. Load it yourself Mon–Sat, 8am–6pm — or call if you need it delivered.
					</p>
					{humusCompost && (
						<div class="max-w-sm">
							<AddToCartButton productSlug={humusCompost.slug} productName={humusCompost.name} />
						</div>
					)}
					<p class="mt-4 text-sm text-warm-600">
						Need a trailer-full? Call {business.phone}.
					</p>
				</div>
				<div class="order-1 lg:order-2 overflow-hidden">
					<CloudinaryImage
						publicId="Soul Miner's/products/compost/TOPO_compost.jpg.jpg"
						alt="Humus compost from Soul Miner's Eden"
						width={900}
						height={720}
						crop="fill"
						gravity="auto"
						loading="lazy"
						class="w-full h-[420px] md:h-[520px] object-cover"
					/>
				</div>
			</div>
		</div>
	</section>

	<section class="section bg-warm-50">
		<div class="container-custom">
			<div class="max-w-xl mb-14">
				<p class="text-[11px] uppercase tracking-[0.22em] text-primary-600 mb-4">Landscape supply</p>
				<h2 class="font-display font-medium text-3xl md:text-4xl text-warm-900 leading-tight">
					Mulch and soil, from the same yard.
				</h2>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-12">
				{humusCompost && <ProductCard product={humusCompost} variant="featured" />}
				{brownMulch && <ProductCard product={brownMulch} variant="default" />}
				{topsoil && <ProductCard product={topsoil} variant="default" />}
			</div>

			<a href="/products" class="text-primary-600 tracking-wide uppercase text-xs font-medium hover:text-primary-700">
				Shop all landscape supply →
			</a>
		</div>
	</section>

	<FarmFresh />

	<section class="section bg-warm-50">
		<div class="container-custom">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
				<div class="overflow-hidden hidden lg:block">
					<CloudinaryImage
						publicId="Soul Miner's/Animals/IMG_2679_z9f17v"
						alt="Animals grazing at Soul Miner's Eden"
						width={900}
						height={720}
						crop="fill"
						gravity="auto"
						loading="lazy"
						class="w-full h-[480px] object-cover"
					/>
				</div>
				<div>
					<p class="text-[11px] uppercase tracking-[0.22em] text-primary-600 mb-4">Land management</p>
					<h2 class="font-display font-medium text-4xl md:text-5xl text-warm-900 leading-tight mb-6">
						Animals doing the work.
					</h2>
					<p class="text-lg text-warm-700 leading-relaxed mb-8">
						HOAs, retention ponds, commercial ground. They eat what you don’t want and leave the land better. Often half the cost of mowing.
					</p>
					<a href="/land-management" class="btn-primary inline-block">
						Talk about grazing
					</a>
				</div>
			</div>
		</div>
	</section>

	<OriginStory />

	<EventsTeaser />

	<section class="bg-warm-50 border-t border-warm-200">
		<div class="container-custom py-14 md:py-16">
			<div class="grid grid-cols-2 md:grid-cols-4 gap-8 max-w-5xl mx-auto">
				<div class="text-center">
					<div class="font-display text-4xl text-warm-900 mb-1">65</div>
					<div class="text-[11px] uppercase tracking-[0.16em] text-warm-600">Acre working farm</div>
				</div>
				<div class="text-center">
					<div class="font-display text-4xl text-warm-900 mb-1">$45</div>
					<div class="text-[11px] uppercase tracking-[0.16em] text-warm-600">A yard of compost</div>
				</div>
				<div class="text-center">
					<div class="font-display text-4xl text-warm-900 mb-1">2017</div>
					<div class="text-[11px] uppercase tracking-[0.16em] text-warm-600">Stewarding this land</div>
				</div>
				<div class="text-center">
					<div class="font-display text-4xl text-warm-900 mb-1">Athens</div>
					<div class="text-[11px] uppercase tracking-[0.16em] text-warm-600">Twenty minutes</div>
				</div>
			</div>
		</div>
	</section>

	<InstagramFeed />

	<ExperienceFarm />
</MainLayout>

<style>
	.hero-section {
		position: relative;
		isolation: isolate;
	}

	.hero-video-wrapper {
		position: absolute;
		inset: 0;
		z-index: -2;
		overflow: hidden;
	}

	.hero-video {
		position: absolute;
		top: 50%;
		left: 50%;
		min-width: 100%;
		min-height: 100%;
		width: auto;
		height: auto;
		transform: translate(-50%, -50%);
		object-fit: cover;
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(to top, rgba(45, 41, 38, 0.55) 0%, rgba(45, 41, 38, 0.2) 55%, rgba(45, 41, 38, 0.25) 100%);
	}
</style>

<script is:inline src="https://cdn.jsdelivr.net/npm/hls.js@1"></script>
<script is:inline>
	document.addEventListener('DOMContentLoaded', function() {
		var video = document.getElementById('hero-video');
		if (!video) return;

		var streamUrl = video.dataset.streamUrl;
		if (!streamUrl) return;

		if (video.canPlayType('application/vnd.apple.mpegurl')) {
			video.src = streamUrl;
			video.play().catch(function() {});
		} else if (typeof Hls !== 'undefined' && Hls.isSupported()) {
			var hls = new Hls();
			hls.loadSource(streamUrl);
			hls.attachMedia(video);
			hls.on(Hls.Events.MANIFEST_PARSED, function() {
				video.play().catch(function() {});
			});
		}
	});
</script>
