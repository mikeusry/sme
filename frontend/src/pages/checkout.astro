---
/**
 * Checkout recap — then hosted Stripe Checkout. Pickup at the farm.
 */
import MainLayout from '../layouts/MainLayout.astro';
import { business } from '../lib/business';
---

<MainLayout title="Checkout" description="Pay now and pick up at the farm">
  <div class="container-custom py-12">
    <h1 class="text-4xl font-display font-bold mb-2">Pay and pick up</h1>
    <p class="text-warm-600 mb-8">Card now. We’ll hold the load at the farm.</p>

    <div id="checkout-loading" class="text-center py-12">
      <div class="inline-flex items-center gap-3 text-warm-600">
        <svg class="w-6 h-6 animate-spin" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Loading checkout...</span>
      </div>
    </div>

    <div id="checkout-empty" class="hidden">
      <div class="card text-center py-12">
        <h2 class="text-2xl font-display font-bold text-warm-900 mb-2">Your cart is empty</h2>
        <p class="text-warm-600 mb-6">Add some products before checking out.</p>
        <a href="/products" class="btn-primary inline-block">Browse Products</a>
      </div>
    </div>

    <div id="checkout-content" class="hidden">
      <div id="canceled-banner" class="hidden mb-6 rounded-lg border border-accent-200 bg-accent-50 px-4 py-3 text-warm-800">
        No charge. When you're ready, pay below.
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2">
          <form id="checkout-form" class="card space-y-6">
            <div>
              <label for="email" class="block text-sm font-medium text-warm-700 mb-1">Email</label>
              <input type="email" id="email" name="email" required class="input w-full" autocomplete="email" placeholder="you@example.com" />
              <p class="text-xs text-warm-500 mt-1">Receipt and pickup details go here.</p>
            </div>

            <div>
              <label for="pickup_notes" class="block text-sm font-medium text-warm-700 mb-1">Pickup notes <span class="font-normal text-warm-500">(optional)</span></label>
              <textarea
                id="pickup_notes"
                name="pickup_notes"
                rows="2"
                class="input w-full"
                placeholder="e.g. Tuesday around 4:45 — 16 ft trailer"
              ></textarea>
            </div>

            <div class="bg-accent-50 border border-accent-200 rounded-lg p-5">
              <h3 class="font-bold text-warm-900 mb-2">Pickup at the farm</h3>
              <p class="text-warm-800">
                {business.address.full}<br />
                {business.hours.display}
              </p>
              <p class="text-sm text-warm-600 mt-3">
                Need it delivered? Call <a href={business.phoneHref} class="font-semibold text-accent-700 underline">{business.phone}</a>
              </p>
            </div>

            <p id="pay-error" class="hidden text-sm text-red-700"></p>

            <button type="submit" id="place-order" class="btn-primary w-full text-lg py-4">
              Pay with Stripe
            </button>
          </form>
        </div>

        <div class="lg:col-span-1">
          <div class="card sticky top-6">
            <h2 class="text-xl font-display font-bold mb-4">Order</h2>
            <div id="checkout-items" class="divide-y divide-warm-200 mb-4"></div>
            <div class="flex justify-between font-bold text-xl pt-4 border-t border-warm-200">
              <span>Total</span>
              <span id="checkout-total">$0.00</span>
            </div>
            <p class="text-sm text-warm-500 mt-3">Pay now · pick up at the farm</p>
            <a href="/cart" class="block text-center text-primary-600 text-sm mt-4 hover:underline">
              Edit cart
            </a>
          </div>
        </div>
      </div>
    </div>

    <div id="checkout-error" class="hidden">
      <div class="card text-center py-12 bg-red-50 border-red-200">
        <h2 class="text-2xl font-display font-bold text-red-900 mb-2">Something went wrong</h2>
        <p class="text-red-600 mb-6" id="error-message">Failed to load checkout</p>
        <a href="/cart" class="btn-primary">Return to cart</a>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  import { initializeCart } from '../lib/cart-store';
  import { formatPrice, lineItemCents, type Cart } from '../lib/medusa-v2';
  import { dollarsFromCents, pdTrack } from '../lib/pd-pixel';

  let cart: Cart | null = null;

  const loadingEl = document.getElementById('checkout-loading');
  const emptyEl = document.getElementById('checkout-empty');
  const contentEl = document.getElementById('checkout-content');
  const errorEl = document.getElementById('checkout-error');
  const errorMessageEl = document.getElementById('error-message');
  const form = document.getElementById('checkout-form') as HTMLFormElement | null;
  const payBtn = document.getElementById('place-order') as HTMLButtonElement | null;
  const payError = document.getElementById('pay-error');

  function showState(state: 'loading' | 'empty' | 'content' | 'error') {
    loadingEl?.classList.toggle('hidden', state !== 'loading');
    emptyEl?.classList.toggle('hidden', state !== 'empty');
    contentEl?.classList.toggle('hidden', state !== 'content');
    errorEl?.classList.toggle('hidden', state !== 'error');
  }

  function setPayError(message: string) {
    if (!payError) return;
    payError.textContent = message;
    payError.classList.toggle('hidden', !message);
  }

  function payLabel() {
    if (!cart) return 'Pay with Stripe';
    return `Pay ${formatPrice(cart.total, cart.currency_code)} with Stripe`;
  }

  function renderOrder() {
    if (!cart) return;
    const current = cart;
    const itemsEl = document.getElementById('checkout-items');
    if (itemsEl) {
      itemsEl.innerHTML = current.items.map(item => `
        <div class="flex gap-3 py-3">
          ${item.thumbnail ? `<img src="${item.thumbnail}" alt="${item.title}" class="w-12 h-12 rounded object-cover flex-shrink-0" />` : `<div class="w-12 h-12 bg-warm-100 rounded flex-shrink-0"></div>`}
          <div class="flex-grow min-w-0">
            <p class="font-medium text-warm-900 text-sm truncate">${item.title}</p>
            <p class="text-xs text-warm-500">Qty: ${item.quantity}</p>
          </div>
          <span class="text-sm font-medium text-warm-900">${formatPrice(lineItemCents(item), current.currency_code)}</span>
        </div>
      `).join('');
    }
    const totalEl = document.getElementById('checkout-total');
    if (totalEl) totalEl.textContent = formatPrice(current.total, current.currency_code);
    if (payBtn) payBtn.textContent = payLabel();
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!cart || !payBtn) return;

    const data = new FormData(form);
    const email = String(data.get('email') || '').trim();
    const notes = String(data.get('pickup_notes') || '').trim();

    if (!email) {
      setPayError('Email is required for the receipt.');
      return;
    }

    payBtn.disabled = true;
    payBtn.textContent = 'Sending you to Stripe…';
    setPayError('');

    try {
      const res = await fetch('/api/stripe/create-checkout-session', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ cartId: cart.id, email, notes }),
      });
      const result = await res.json();
      if (!res.ok || !result.url) {
        throw new Error(result.message || 'Could not start Stripe Checkout');
      }
      window.location.href = result.url;
    } catch (err) {
      console.error('Checkout failed:', err);
      setPayError(err instanceof Error ? err.message : 'Could not start payment. Call (706) 613-4415.');
      payBtn.disabled = false;
      payBtn.textContent = payLabel();
    }
  });

  async function init() {
    try {
      showState('loading');
      cart = await initializeCart();
      if (!cart || cart.items.length === 0) {
        showState('empty');
        return;
      }

      if (new URLSearchParams(window.location.search).get('canceled') === '1') {
        document.getElementById('canceled-banner')?.classList.remove('hidden');
      }

      renderOrder();
      showState('content');
      pdTrack('begin_checkout', {
        cart_value: dollarsFromCents(cart.total),
        cart_item_count: cart.items.length,
      });
    } catch (error: any) {
      console.error('Failed to load checkout:', error);
      if (errorMessageEl) errorMessageEl.textContent = error.message || 'Failed to load checkout';
      showState('error');
    }
  }

  init();
</script>
