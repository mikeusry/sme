# Soul Miner's Eden Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================================================
# Medusa Backend (Required)
# ============================================================================
PUBLIC_MEDUSA_BACKEND_URL=https://backend-production-2bafd.up.railway.app
PUBLIC_MEDUSA_PUBLISHABLE_KEY=your_medusa_key_here
MEDUSA_BACKEND_URL=https://backend-production-2bafd.up.railway.app

# Admin API Access (Required for /admin/orders)
# Create admin user in Medusa backend first
MEDUSA_ADMIN_EMAIL=admin@soulminerseden.com
MEDUSA_ADMIN_PASSWORD=your_admin_password_here

# Shared password for /admin and /api/admin (Andi + Mike).
# Not the Medusa password. Set the same value on Vercel.
SITE_ADMIN_PASSWORD=

# Nexus SME tenant — paid farm tickets land as SME-COMPOST orders
SME_SUPABASE_URL=https://vsgfoboyirpdkzcqzwvl.supabase.co
SME_SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# Stripe (required — checkout pays now)
# ============================================================================
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...

# ============================================================================
# Cloudinary (Required for Images)
# ============================================================================
PUBLIC_CLOUDINARY_CLOUD_NAME=southland-organics
PUBLIC_CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
PUBLIC_CLOUDINARY_FOLDER=Soul Miner's/

# ============================================================================
# Supabase (Optional - for analytics/admin features)
# ============================================================================
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_key

# ============================================================================
# Site Configuration
# ============================================================================
PUBLIC_SITE_NAME=Soul Miner's Eden
PUBLIC_SITE_URL=https://www.soulminerseden.com

# ============================================================================
# Customer.io (Southland workspace — required for email signups)
# Copy Track keys from mothership. SME profiles are tagged sub_brand=soul-miners-eden.
# ============================================================================
CUSTOMERIO_SITE_ID=
CUSTOMERIO_TRACK_API_KEY=

# ============================================================================
# Email Notifications (Optional - choose one provider)
# ============================================================================

# Option 1: SendGrid
# SENDGRID_API_KEY=SG....
# SENDGRID_FROM_EMAIL=orders@soulminerseden.com

# Option 2: Resend
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=orders@soulminerseden.com

# Option 3: SMTP (any provider)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=orders@soulminerseden.com

# ============================================================================
# MUX Video (Optional - for video backgrounds)
# ============================================================================
# MUX_TOKEN_ID=...
# MUX_TOKEN_SECRET=...

# ============================================================================
# Development Settings
# ============================================================================
# Local storefront still talks to Railway. Do not point this at localhost:9000.
# PUBLIC_SITE_URL=http://localhost:4321
